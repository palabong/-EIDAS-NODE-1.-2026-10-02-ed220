# ==============================================================================
# Project Bilanx / eIDAS Node — Environment & Secret Manager Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development (cp .env.example .env)
# 2. In production (Fly.io / Cloud Run / Kubernetes), inject secrets via your
#    platform Secret Manager (e.g., `fly secrets set KEY=VALUE` or GCP Secret Manager)
# 3. NEVER commit actual .env files, API keys, tokens, or private keys to git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Google AI / Gemini Credentials (Secret Manager in Production)
# ------------------------------------------------------------------------------
# Inject via Secret Manager (e.g., GCP Secret Manager / `fly secrets set GEMINI_API_KEY=...`).
# In local development, the server boots normally without this key.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Web Client (Google Identity Services)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials.
# At runtime, /api/auth/config serves GOOGLE_CLIENT_ID to the frontend automatically.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Google Cloud / Firestore Audit Persistence (Optional)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=(default)
USE_FIRESTORE=false

# ------------------------------------------------------------------------------
# 5. Institutional Authority Signing Key (REM-01)
# ------------------------------------------------------------------------------
# Option A (Cloud Secret Manager env injection): JWK JSON string
# INSTITUTIONAL_KEY_JSON='{"publicKeyJwk":{"kty":"EC","crv":"P-256",...},"privateKeyJwk":{"kty":"EC","crv":"P-256","d":"...",...}}'
# Option B (Secret volume mount): Path to mounted secret file
# INSTITUTIONAL_KEY_PATH=/run/secrets/institutional-key.json
# Note: In development, if neither is provided, an ephemeral in-memory key is generated.
# In production, one of the two MUST be supplied. The server fails closed if neither resolves.
# Optional key id. When unset, the server derives p256-<sha256 prefix> from the public key.
# INSTITUTIONAL_KEY_ID=ch-primary-2026
# Optional second key for the Italian jurisdiction. When both are unset, the primary key signs IT too.
# INSTITUTIONAL_KEY_JSON_IT=
# INSTITUTIONAL_KEY_PATH_IT=/run/secrets/institutional-key-it.json
# INSTITUTIONAL_KEY_ID_IT=it-primary-2026
# KMS seam: INSTITUTIONAL_KEY_SOURCE=kms fails closed until an InstitutionalKeySource adapter is registered.
# INSTITUTIONAL_KEY_SOURCE=env

# ------------------------------------------------------------------------------
# 5b. Single-node security store (nonces, WebAuthn counters, revocations)
# ------------------------------------------------------------------------------
# Unset or "memory": process-local. A restart drops nonces, counters, and revocations.
# "file": one JSON snapshot per map under SECURITY_STORE_PATH (default data/security-store).
# One process only. A second process on the same files will clobber them.
# The snapshots hold public credential material and nonces. Do not point this at private keys.
# SECURITY_STORE=file
# SECURITY_STORE_PATH=data/security-store
# Clearance audit JSON lines. Unset writes one JSON object per event to stdout.
# The file receives the allow-listed fields only (event, jurisdiction, latency, reason, key id).
# AUDIT_LOG_PATH=data/clearance-audit.log

# ------------------------------------------------------------------------------
# 6. Session & Cookie Security (REM-02)
# ------------------------------------------------------------------------------
# Set to 'true' in production behind HTTPS to enforce the 'Secure' cookie flag
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 7. eIDAS 2.0 SAML Service Provider & Trust Anchor Configuration
# ------------------------------------------------------------------------------
SAML_SP_ENTITY_ID=http://localhost:3000/saml/metadata
SAML_SP_ACS_URL=http://localhost:3000/saml/acs
SAML_IDP_SSO_URL=http://peps.local:9090/PEPS/ServiceProvider
SAML_DEFAULT_LOA=http://eidas.europa.eu/LoA/substantial
SAML_ENGINE_URL=http://127.0.0.1:8000

# Optional SAML Trust Anchors & Signing Keys (Secret Manager / Volume Mounts)
# When unset in development/CI, saml_engine generates ephemeral keys in OS temp storage.
# SAML_TRUSTED_CERTS_DIR=/run/secrets/saml-idp-certs
# SAML_DISABLE_EPHEMERAL_CERTS=true
# SAML_SP_CERT_PATH=/run/secrets/saml-sp.crt
# SAML_SP_RSA_KEY_PATH=/run/secrets/saml-sp.key
# SAML_IDP_RSA_KEY_PATH=/run/secrets/saml-idp-rsa.key
# SAML_IDP_RSA_CERT_PATH=/run/secrets/saml-idp-rsa.crt
# SAML_IDP_EC_KEY_PATH=/run/secrets/saml-idp-ec.key
# SAML_IDP_EC_CERT_PATH=/run/secrets/saml-idp-ec.crt
