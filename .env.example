# ==============================================================================
# Project Bilanx / eIDAS Node — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (cp .env.example .env)
# 2. Populate with local or deployment values
# 3. NEVER commit your actual .env file or private keys to git
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Google AI / Gemini Credentials (Optional for local development)
# ------------------------------------------------------------------------------
# Required for Gemini AI API calls and synthetic intelligence features.
# In local development, the server boots normally without this key.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Web Client (Required for Google Identity Services)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. Institutional Authority Signing Key (REM-01)
# ------------------------------------------------------------------------------
# Option A (Recommended for Cloud Run / K8s): Injected JWK JSON string
# INSTITUTIONAL_KEY_JSON='{"publicKeyJwk":{"kty":"EC","crv":"P-256",...},"privateKeyJwk":{"kty":"EC","crv":"P-256","d":"...",...}}'
# Option B (Secret volume mount): Path to secret file
# INSTITUTIONAL_KEY_PATH=/run/secrets/institutional-key.json
# Note: In development, if neither is provided, an ephemeral in-memory key is generated.
# In production, one of the two MUST be supplied.

# ------------------------------------------------------------------------------
# 5. Session & Cookie Security (REM-02)
# ------------------------------------------------------------------------------
# Set to 'true' in production behind HTTPS to enforce the 'Secure' cookie flag
COOKIE_SECURE=false

# ------------------------------------------------------------------------------
# 6. eIDAS 2.0 SAML Service Provider Configuration
# ------------------------------------------------------------------------------
SAML_SP_ENTITY_ID=http://localhost:3000/saml/metadata
SAML_SP_ACS_URL=http://localhost:3000/saml/acs
SAML_IDP_SSO_URL=http://peps.local:9090/PEPS/ServiceProvider
SAML_DEFAULT_LOA=http://eidas.europa.eu/LoA/substantial
SAML_ENGINE_URL=http://127.0.0.1:8000
